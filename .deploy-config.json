{
  "serviceName": "agentic-screencast",
  "dockerComposePath": "docker-compose.yml",
  "dockerfile": "Dockerfile",
  "buildContext": ".",
  "platform": "linux/amd64",
  "remoteDir": "/opt/agentic-screencast",
  "imageName": "agentic-screencast-site",
  "deploymentType": "build",
  "healthCheck": {
    "containerName": "agentic-screencast-site",
    "timeout": 120,
    "interval": 3
  }
}
