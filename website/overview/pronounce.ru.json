{
  "_": "Чтение для SpeechKit filipp: он читает латиницу сам, поэтому переписываются только названия и сокращения, которые он произносит неверно, а адреса сайтов выбрасываются.",
  "say": {
    "Agentic Screencast": "Эджентик Скринкаст",
    "SpeechKit": "Спичкит",
    "Playwright": "Плейрайт",
    "Chromium": "Хромиум",
    "ffmpeg": "эф-эф-эм-пег",
    "WebGL": "веб-джи-эл",
    "WebVTT": "веб-ви-ти-ти",
    "README": "ридми",
    "brief.md": "бриф-эм-дэ",
    "CREDITS.md": "кредитс-эм-дэ",
    "MP4": "эм-пэ-четыре",
    "CSV": "си-эс-ви",
    "SRT": "эс-эр-тэ",
    "GIF": "гиф",
    "Enter": "Энтер",
    "Piper": "Пайпер",
    "lint": "линт",
    "frames": "фреймс",
    "record": "рекорд",
    "look": "лук",
    "zone": "зоун",
    "filipp": "Филипп",
    "john": "Джон"
  },
  "drop": ["\\s*\\b[\\w-]+(?:\\.[\\w-]+)*\\.(?:com|ru|io|dev|org|net)\\b"],
  "cleanup": [["\\s+([:,.;])", "$1"]],
  "order": ["drop", "say", "cleanup"],
  "caseSensitive": true
}
