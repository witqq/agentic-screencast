{
  "name": "agentic-screencast",
  "version": "1.3.0",
  "type": "module",
  "description": "A video-building CLI for AI agents: declarative scenarios, narration, reproducible frames and MP4 output.",
  "keywords": [
    "screencast",
    "video",
    "automation",
    "ai-agents",
    "playwright",
    "text-to-speech"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/witqq/agentic-screencast.git"
  },
  "homepage": "https://agentic-screencast.witqq.dev/",
  "bugs": {
    "url": "https://github.com/witqq/agentic-screencast/issues"
  },
  "types": "./dist/capture.d.ts",
  "exports": {
    ".": {
      "types": "./dist/capture.d.ts",
      "import": "./dist/capture.js"
    },
    "./capture": {
      "types": "./dist/capture.d.ts",
      "import": "./dist/capture.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.json && node -e \"require('fs').cpSync('assets/palettes','dist/palettes',{recursive:true})\" && tsc -p tsconfig.browser.json && node scripts/embed-theme.mjs && vite build && node -e \"require('fs').cpSync('src/rules','dist/rules',{recursive:true})\" && node -e \"require('fs').chmodSync('dist/agentic-screencast.js', 0o755)\"",
    "prepare": "npm run build",
    "types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "lint": "oxlint src scripts --deny-warnings",
    "unit": "node --import ./dist/tests/locale.js --test --test-timeout=900000 dist/tests/unit/*.test.js",
    "e2e:tests": "node --import ./dist/tests/locale.js --test --test-timeout=900000 dist/tests/e2e/*.test.js",
    "e2e": "npm run build && npm run e2e:tests && npm run suite && npm run site:check",
    "suite": "node --import ./dist/tests/locale.js dist/tests/suite.js",
    "matrix:transitions": "node --import ./dist/tests/locale.js dist/tests/transitions-matrix.js",
    "check": "node dist/agentic-screencast.js check",
    "verify": "node dist/agentic-screencast.js verify",
    "voices": "node dist/agentic-screencast.js voices",
    "test": "npm run build && npm run types && npm run lint && npm run unit",
    "voice-check": "node dist/voice-check.js",
    "schema": "node dist/agentic-screencast.js schema",
    "record": "node dist/agentic-screencast.js record",
    "pack:check": "npm run build && node scripts/check-package.mjs",
    "history:check": "node scripts/check-public-history.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:static": "npm run site:build && node scripts/landing-fingerprints.mjs && node scripts/check-site-static.mjs",
    "site:check": "npm run site:build && node scripts/landing-fingerprints.mjs && node scripts/check-site.mjs",
    "landing:fingerprints": "node scripts/landing-fingerprints.mjs",
    "deploy:prepare": "node scripts/build-site.mjs --require-clean",
    "deploy:config": "infra-tools config .deploy-config.json --server witqq.ru",
    "deploy:prod": "npm run deploy:prepare && infra-tools auto --server witqq.ru --config .deploy-config.json --no-log",
    "ci:verify": "npm test && npm run pack:check && npm run site:static",
    "nightly:verify": "npm run ci:verify && npm run e2e:tests && npm run suite && node scripts/check-site.mjs",
    "release:check": "npm run history:check && npm run ci:verify"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "ffmpeg-static": "5.3.0",
    "playwright": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "license": "GPL-3.0-or-later",
  "bin": {
    "agentic-screencast": "./dist/agentic-screencast.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "!dist/tests",
    "src",
    "assets",
    "templates",
    "docs/film-craft.md",
    "docs/scenario-playbook.md",
    "docs/vertical-video.md",
    "docs/visual-assets.md",
    "docs/visual-design.md",
    "docs/sound.md",
    "docs/theme-tokens.md",
    "example/story.md",
    "example/agent-video.md",
    "example/kinetic-video.md",
    "example/idea-video.md",
    "example/pages/prototype.html",
    "example/live-capture.mjs",
    "skills/agentic-screencast/SKILL.md",
    "README.md",
    "README.ru.md",
    "docs/reference.md",
    "AGENTS.md",
    "CLAUDE.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "scene.example.json",
    "tsconfig.json",
    "tsconfig.browser.json"
  ],
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "agentic-report": "0.17.0",
    "ajv": "8.20.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "peerDependencies": {
    "agentic-report": ">=0.17.0"
  },
  "peerDependenciesMeta": {
    "agentic-report": {
      "optional": true
    }
  }
}
