node_modules/
.agentic-screencast/
*.mp4

# Ключ доступа к синтезу. README велит класть CLOUD_KEY в .env в корне
# проекта, а корень проекта теперь и есть корень репозитория: без этой
# строки первый же пользователь закоммитил бы свой ключ.
.env
.env.*

# Порождается из файла сценария — правится только через него.
# README велит читателю держать это вне системы контроля версий;
# продукт обязан вести себя так же на собственном примере.
#
# Путь ЯКОРНЫЙ, а не «любой каталог с таким именем»: неякорное `slides/`
# заодно выбрасывало из истории `src/slides` с компонентами слайдов —
# исходники исчезли бы при клонировании, а сборка молча собрала бы
# не то. Порождаемое лежит рядом с источником, и здесь источник один.
.generated-*.json
/example/slides/

# Собранное: порождается из src, в историю не входит
dist/
/site/

# Локальные отчёты агента и статус работы не являются продуктом.
agent_temp_files_local/
.agent-status

# Внешние реализации ставятся отдельно и в историю инструмента не входят.
# Окружение у них ОБЩЕЕ и лежит в external/: путь должен совпадать с тем,
# который предписывает external/README.md, иначе поставивший внешнюю
# половину получит шестьсот мегабайт неотслеживаемых файлов, git status
# перестанет быть сигналом, а коммит по всему дереву унесёт torch
# в историю.
external/.venv/
external/silero/v5_ru.pt
